# ============================================
# SIMAS-GPS — Template Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# JANGAN push file .env ke GitHub!
# ============================================

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=simas_gps
DB_USER=root
DB_PASS=

# Aplikasi
APP_ENV=production
# BASE_PATH: path prefix URL. Kosongkan jika deploy di root domain Railway.
# Isi '/absensi_gps' jika jalan di XAMPP lokal subfolder.
BASE_PATH=
